# Copy to .env (dev) or /etc/tracker.env (systemd) and edit.
TRACKER_DATA_DIR=./data
TRACKER_CURRENCY=$
# Optional HTTP Basic auth. Set BOTH to enable. Use HTTPS or a private network (see README).
TRACKER_USER=
TRACKER_PASS=
# Unit used to display body weight (entries can still be made in either): kg or lb
TRACKER_WEIGHT_UNIT=kg
