[Unit]
Description=Tracker
After=network.target

[Service]
User=tracker
Group=tracker
WorkingDirectory=/opt/tracker
EnvironmentFile=/etc/tracker.env
ExecStart=/opt/tracker/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/tracker/data

[Install]
WantedBy=multi-user.target
